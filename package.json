{
  "name": "copy-changed",
  "version": "0.9.0",
  "description": "Javascript library copying changed files only.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts",
        "default": "./dist/index.d.mts"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm --dts",
    "lint": "run-p lint:*",
    "lint:ts": "biome check",
    "lint:ts:types": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "clean": "rimraf ./dist ./coverage",
    "prepublishOnly": "bun run build",
    "npm-dry-run": "npm publish --dry-run",
    "rebuild": "run-s clean build",
    "reset": "npm-run-all clean --parallel reset:*",
    "reset:turbo": "find . -type d -name .turbo -exec rm -rf {} +",
    "reset:node": "find . -type d -name node_modules -exec rm -rf {} +",
    "prepare-to-commit": "run-s lint test build clean"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shnam7/copy-changed.git"
  },
  "homepage": "https://github.com/shnam7/copy-changed#readme",
  "bugs": {
    "url": "https://github.com/shnam7/copy-changed/issues"
  },
  "author": "Robin Nam (https://github.com/shnam7)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "copy",
    "changed"
  ],
  "dependencies": {
    "chalk": "^6.0.0",
    "common-path-prefix": "^3.0.0",
    "del": "^8.0.1",
    "glob-parent": "^6.0.2",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/glob-parent": "^5.1.3",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "npm-run-all2": "^9.0.3",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "bun@1.3.14"
}
