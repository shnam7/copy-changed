{
  "name": "copy-changed",
  "version": "0.13.0",
  "description": "A Node.js utility library that copies only changed files from source to destination.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts",
        "default": "./dist/index.d.mts"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format cjs,esm --dts",
    "lint": "run-p lint:*",
    "lint:ts": "biome check",
    "lint:ts:types": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "clean": "rimraf ./dist ./coverage",
    "rebuild": "run-s clean build",
    "prepare-to-commit": "run-s clean lint test build clean",
    "prepublishOnly": "bun run build",
    "npm-dry-run": "npm publish --dry-run",
    "reset": "run-s clean reset:turbo reset:node",
    "reset:turbo": "find . -type d -name .turbo -exec rm -rf {} +",
    "reset:node": "find . -type d -name node_modules -exec rm -rf {} +"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shnam7/copy-changed.git"
  },
  "homepage": "https://github.com/shnam7/copy-changed#readme",
  "bugs": {
    "url": "https://github.com/shnam7/copy-changed/issues"
  },
  "author": "Robin Nam (https://github.com/shnam7)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "copy",
    "changed"
  ],
  "dependencies": {
    "@wicle/tiny-logger": "^0.11.1",
    "common-path-prefix": "^3.0.0",
    "del": "^9.0.1",
    "glob-parent": "^6.0.2",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@changesets/cli": "^3.0.3",
    "@types/glob-parent": "^5.1.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "npm-run-all2": "^9.0.4",
    "rimraf": "^6.1.3",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.4.4"
}
